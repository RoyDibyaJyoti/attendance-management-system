# ==============================================================================
# AMCS Production Environment Configuration Template (.env.example)
# Copy this file to .env and fill in secure, production-grade values.
# NEVER commit .env with real credentials to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=amcs_db
POSTGRES_USER=amcs_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_VERY_SECURE_PASSWORD_32_CHARS_MIN
POSTGRES_PORT=5432

# Connection pool settings
SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 2. Security & JWT Configuration
# ------------------------------------------------------------------------------
# MUST be at least 256 bits (32 bytes). In production, generate using:
# openssl rand -base64 48
AMCS_JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48_MIN_32_BYTES

# JWT Issuer name
AMCS_JWT_ISSUER=amcs-auth-service

# JWT expiration in seconds (default: 3600 = 1 hour)
AMCS_JWT_EXPIRATION_SECONDS=3600

# CORS Allowed Origins (Comma-separated HTTPS domains)
AMCS_CORS_ALLOWED_ORIGINS=https://amcs.university.edu

# ------------------------------------------------------------------------------
# 3. Application Lifecycle
# ------------------------------------------------------------------------------
# In production, MUST remain false to prevent seeding test accounts
AMCS_BOOTSTRAP_ENABLED=false

# Spring Boot active profile
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 4. Web Gateway & Networking
# ------------------------------------------------------------------------------
# Public HTTP port on host
HTTP_PORT=80

# Public HTTPS port on host (when using SSL termination)
HTTPS_PORT=443

# Rate limiting settings
AMCS_RATE_LIMIT_AUTH=10
AMCS_RATE_LIMIT_HEAVY=25
